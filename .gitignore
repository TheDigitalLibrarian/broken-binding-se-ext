# dependencies
node_modules/

# logs / OS cruft
*.log
.DS_Store

# desktop app scratch (saved copies of delivered files)
outputs/

# test scratch
test/run.min.mjs

# build artifacts — regenerate with `npm run build`.
# Two of them are tracked because they ARE the distribution: the userscript's raw URL
# is the install link (and what Greasy Fork syncs from), and the bookmarklet is a line
# you copy. The .min.js is an intermediate, and install.html would not render from
# raw.githubusercontent.com anyway — it serves everything as text/plain.
dist/*
!dist/broken-binding-se-ext.user.js
!dist/bookmarklet.txt
